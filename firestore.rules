rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document
    match /usuarios/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && validarUsuario(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && validarUsuario(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Pelotones: any authenticated user can read; only creator can write
    match /pelotones/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.lider == request.auth.uid;
      allow update: if request.auth != null;   // permite unirse (arrayUnion participantes)
      allow delete: if request.auth != null
                    && resource.data.lider == request.auth.uid;

      // Chat del pelotón
      match /mensajes/{msgId} {
        allow read:          if request.auth != null;
        allow create:        if request.auth != null
                             && request.resource.data.autorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Reportes: any authenticated user can read; only author can write
    match /reportes/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.autorUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.autorUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.autorUid == request.auth.uid;
    }

    // SOS: solo el propio usuario puede leer/escribir su documento
    match /sos/{uid} {
      allow read:          if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete:        if false;
    }

    // Actividad del usuario: solo él puede leer y escribir sus eventos
    match /actividad/{uid}/eventos/{eventoId} {
      allow read:          if request.auth != null && request.auth.uid == uid;
      allow create:        if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Validation helpers ----
    function validarUsuario(data) {
      return data.nombre is string       && data.nombre.size()       <= 100
          && data.universidad is string  && data.universidad.size()  <= 120
          && (!(data.keys().hasAll(['carrera'])) || data.carrera is string && data.carrera.size() <= 100)
          && (!(data.keys().hasAll(['barrio']))   || data.barrio  is string && data.barrio.size()  <= 80);
    }
  }
}
