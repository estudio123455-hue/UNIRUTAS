rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document
    match /usuarios/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && validarUsuario(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && validarUsuario(request.resource.data);
      allow delete: if false;
    }

    // Pelotones: any authenticated user can read; only creator can write
    match /pelotones/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.creadorUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.creadorUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.creadorUid == request.auth.uid;
    }

    // Reportes: any authenticated user can read; only author can write
    match /reportes/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.autorUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.autorUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.autorUid == request.auth.uid;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Validation helpers ----
    function validarUsuario(data) {
      return data.nombre is string       && data.nombre.size()       <= 100
          && data.universidad is string  && data.universidad.size()  <= 120
          && (!(data.keys().hasAll(['carrera'])) || data.carrera is string && data.carrera.size() <= 100)
          && (!(data.keys().hasAll(['barrio']))   || data.barrio  is string && data.barrio.size()  <= 80);
    }
  }
}
